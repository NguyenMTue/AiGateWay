@page "/virtual-keys"
@rendermode InteractiveServer
@inject ISender Sender

<PageTitle>AI Gateway - Quản lý Khóa ảo</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0">🔑 Quản Lý Khóa Ảo & Giám Sát Ngân Sách</h2>
        <p class="text-muted m-0">Quản lý quota client, giới hạn RPM/TPM, phân quyền model và cảnh báo ngân sách 90%</p>
    </div>
    <button class="btn btn-outline-primary" @onclick="LoadKeysAsync">
        <i class="bi bi-arrow-clockwise me-1"></i> Làm mới danh sách
    </button>
</div>

@if (_isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Đang tải...</span>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tên Khóa</th>
                            <th>Key Prefix / Mask</th>
                            <th>Giới hạn RPM</th>
                            <th>Giới hạn TPM</th>
                            <th>Ngân sách tối đa ($)</th>
                            <th>Chi tiêu hiện tại</th>
                            <th>% Ngân sách đã dùng</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_keys != null && _keys.Any())
                        {
                            @foreach (var key in _keys)
                            {
                                var percent = key.MaxBudgetUsd.HasValue && key.MaxBudgetUsd.Value > 0
                                    ? (key.CurrentUsageUsd / key.MaxBudgetUsd.Value) * 100m
                                    : 0m;

                                <tr>
                                    <td class="fw-bold">@key.Name</td>
                                    <td><code>@key.KeyMask</code></td>
                                    <td>@(key.RateLimitRpm?.ToString("N0") ?? "Không giới hạn")</td>
                                    <td>@(key.RateLimitTpm?.ToString("N0") ?? "Không giới hạn")</td>
                                    <td>@(key.MaxBudgetUsd.HasValue ? $"${key.MaxBudgetUsd.Value:F2}" : "Không giới hạn")</td>
                                    <td class="fw-bold text-success">$@key.CurrentUsageUsd.ToString("F4")</td>
                                    <td style="width: 180px;">
                                        @if (key.MaxBudgetUsd.HasValue && key.MaxBudgetUsd.Value > 0)
                                        {
                                            <div class="progress" style="height: 18px;">
                                                <div class="progress-bar @(percent >= 90 ? "bg-danger" : percent >= 75 ? "bg-warning" : "bg-success")"
                                                     role="progressbar"
                                                     style="width: @(Math.Min(100, percent))%; font-size: 11px; font-weight: bold;">
                                                    @percent.ToString("F1")%
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!key.IsActive)
                                        {
                                            <span class="badge bg-secondary">Tạm ngừng</span>
                                        }
                                        else if (percent >= 90)
                                        {
                                            <span class="badge bg-danger">⚠️ Cảnh báo ngân sách (>=90%)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Đang hoạt động</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Chưa có khóa ảo nào được tạo.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private List<VirtualKeyDto>? _keys;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadKeysAsync();
    }

    private async Task LoadKeysAsync()
    {
        _isLoading = true;
        try
        {
            _keys = await Sender.Send(new GetVirtualKeysQuery());
        }
        catch
        {
            _keys = new List<VirtualKeyDto>();
        }
        finally
        {
            _isLoading = false;
        }
    }
}
