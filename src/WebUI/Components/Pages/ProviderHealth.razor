@page "/provider-health"
@rendermode InteractiveServer
@inject ISender Sender
@inject ICircuitBreakerService CircuitBreaker

<PageTitle>AI Gateway - Hiệu năng & Độ ổn định Provider</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0">🏥 Hiệu Năng & Độ Ổn Định Provider AI (Circuit Breaker)</h2>
        <p class="text-muted m-0">Giám sát độ trễ, lỗi 429 Rate Limit, lỗi 5xx Server và cơ chế tự động ngắt/phục hồi mạch</p>
    </div>
    <button class="btn btn-outline-primary" @onclick="LoadHealthAsync">
        <i class="bi bi-arrow-clockwise me-1"></i> Làm mới dữ liệu
    </button>
</div>

@if (_isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Đang tải...</span>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white fw-bold">Dữ Liệu Giám Sát Hiệu Năng & Độ Ổn Định Provider</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nhà cung cấp</th>
                            <th>Tổng Request</th>
                            <th>Thành công</th>
                            <th>Thất bại</th>
                            <th>Lỗi 429 (Rate Limit)</th>
                            <th>Lỗi 5xx (Server)</th>
                            <th>Tỷ lệ lỗi %</th>
                            <th>Độ trễ TB</th>
                            <th>Độ Ổn Định</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_stats != null && _stats.Any())
                        {
                            @foreach (var s in _stats)
                            {
                                <tr>
                                    <td class="fw-bold">@s.ProviderName</td>
                                    <td>@s.TotalRequests</td>
                                    <td class="text-success font-monospace">@s.SuccessfulRequests</td>
                                    <td class="text-danger font-monospace">@s.FailedRequests</td>
                                    <td>@s.Error429Count</td>
                                    <td>@s.Error5xxCount</td>
                                    <td>
                                        <span class="fw-bold @(s.ErrorRatePercent > 10 ? "text-danger" : "text-dark")">
                                            @s.ErrorRatePercent%
                                        </span>
                                    </td>
                                    <td>@s.AverageLatencyMs ms</td>
                                    <td>
                                        @if (s.ErrorRatePercent > 10)
                                        {
                                            <span class="badge bg-danger">🚨 Tỷ lệ lỗi cao (>10%)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">🟢 Ổn định</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">Chưa có nhật ký request. Hãy chạy `dotnet run --project .\src\MockClient` để tạo dữ liệu request thử nghiệm.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private List<ProviderHealthStatsDto>? _stats;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadHealthAsync();
    }

    private async Task LoadHealthAsync()
    {
        _isLoading = true;
        try
        {
            _stats = await Sender.Send(new GetProviderHealthStatsQuery());
        }
        catch
        {
            _stats = new List<ProviderHealthStatsDto>();
        }
        finally
        {
            _isLoading = false;
        }
    }
}
