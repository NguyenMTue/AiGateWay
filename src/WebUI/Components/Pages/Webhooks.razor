@page "/webhooks"
@rendermode InteractiveServer
@inject IOptions<WebhookSettings> WebhookOptions
@inject IWebhookNotificationService WebhookService

<PageTitle>AI Gateway - Cảnh báo Webhook</PageTitle>

<div class="mb-4">
    <h2 class="fw-bold m-0">🔔 Cảnh Báo Webhook Thời Gian Thực (Slack / Discord)</h2>
    <p class="text-muted m-0">Tự động phát cảnh báo vận hành khi ngân sách Khóa ảo đạt 90% hoặc tỷ lệ lỗi Nhà cung cấp vượt quá 10%</p>
</div>

<div class="row g-4">
    <!-- Webhook Settings Overview -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white fw-bold">⚙️ Cấu Hình Webhook Hiện Tại</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">TRẠNG THÁI THÔNG BÁO WEBHOOK</label>
                    <div>
                        @if (Settings.Enabled)
                        {
                            <span class="badge bg-success fs-6">Đã kích hoạt (Hoạt động)</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">Chưa kích hoạt</span>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">URL DISCORD WEBHOOK</label>
                    <input type="text" class="form-control font-monospace" value="@(string.IsNullOrWhiteSpace(Settings.DiscordWebhookUrl) ? "Chưa cấu hình" : Settings.DiscordWebhookUrl)" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">URL SLACK WEBHOOK</label>
                    <input type="text" class="form-control font-monospace" value="@(string.IsNullOrWhiteSpace(Settings.SlackWebhookUrl) ? "Chưa cấu hình" : Settings.SlackWebhookUrl)" readonly />
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label text-muted small fw-bold">NGƯỠNG CẢNH BÁO NGÂN SÁCH</label>
                        <div class="fw-bold fs-5 text-warning">@Settings.BudgetThresholdPercent%</div>
                    </div>
                    <div class="col-6">
                        <label class="form-label text-muted small fw-bold">NGƯỠNG TỶ LỆ LỖI</label>
                        <div class="fw-bold fs-5 text-danger">@Settings.ProviderErrorRateThresholdPercent%</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Live Webhook Test Form -->
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white fw-bold">🧪 Thử Nghiệm Bật Cảnh Báo Webhook</div>
            <div class="card-body">
                <p class="text-muted small">Gửi cảnh báo thử nghiệm ngay lập tức tới channel Discord và Slack đã cấu hình để kiểm tra định dạng và kết nối.</p>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Chọn loại cảnh báo để thử nghiệm:</label>
                    <select class="form-select" @bind="_selectedAlertType">
                        <option value="budget">⚠️ Cảnh báo Ngân sách Khóa ảo 90%</option>
                        <option value="health">🚨 Cảnh báo Tỷ lệ lỗi Nhà cung cấp (>10%)</option>
                        <option value="circuit">🔴 Cảnh báo Circuit Breaker Ngắt Mạch (OPEN)</option>
                    </select>
                </div>

                @if (!string.IsNullOrEmpty(_statusMessage))
                {
                    <div class="alert @_statusClass alert-dismissible fade show" role="alert">
                        @_statusMessage
                    </div>
                }

                <button class="btn btn-primary w-100 mt-2" @onclick="SendTestAlertAsync" disabled="@_isSending">
                    @if (_isSending)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Đang phát Webhook...</span>
                    }
                    else
                    {
                        <i class="bi bi-send-fill me-2"></i>
                        <span>Gửi Cảnh Báo Thử Nghiệm Ngay</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private WebhookSettings Settings => WebhookOptions.Value;
    private string _selectedAlertType = "budget";
    private bool _isSending;
    private string? _statusMessage;
    private string _statusClass = "alert-info";

    private async Task SendTestAlertAsync()
    {
        _isSending = true;
        _statusMessage = null;

        try
        {
            if (string.IsNullOrWhiteSpace(Settings.DiscordWebhookUrl) && string.IsNullOrWhiteSpace(Settings.SlackWebhookUrl))
            {
                _statusClass = "alert-warning";
                _statusMessage = "⚠️ Chưa cấu hình Webhook URL cho Discord hoặc Slack trong appsettings.json. Vui lòng thêm Webhook URL để thử nghiệm.";
                return;
            }

            switch (_selectedAlertType)
            {
                case "budget":
                    await WebhookService.SendVirtualKeyBudgetAlertAsync(
                        virtualKeyId: 999,
                        keyName: "Test-GameClient-Key",
                        keyMask: "gw-live-...test",
                        currentUsageUsd: 91.50m,
                        maxBudgetUsd: 100.00m);
                    break;

                case "health":
                    await WebhookService.SendProviderHealthAlertAsync(
                        providerId: 1,
                        providerName: "OpenAI (Test)",
                        errorRatePercent: 14.5,
                        totalRequests: 200,
                        failedRequests: 29,
                        error429Count: 20,
                        error5xxCount: 9);
                    break;

                case "circuit":
                    await WebhookService.SendCircuitBreakerAlertAsync(
                        providerApiKeyId: 12,
                        providerName: "Google Gemini (Test)",
                        consecutiveFailures: 3,
                        breakDuration: TimeSpan.FromSeconds(60));
                    break;
            }

            _statusClass = "alert-success";
            _statusMessage = "✅ Đã gửi cảnh báo thử nghiệm Webhook thành công! Hãy kiểm tra channel Discord / Slack của bạn.";
        }
        catch (Exception ex)
        {
            _statusClass = "alert-danger";
            _statusMessage = $"❌ Gửi cảnh báo thử nghiệm thất bại: {ex.Message}";
        }
        finally
        {
            _isSending = false;
        }
    }
}
